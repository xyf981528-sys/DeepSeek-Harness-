{
  "name": "dsh-restart",
  "version": "0.1.0",
  "private": true,
  "description": "One-click restart for DeepSeek Harness: a sidebar panel with a single button",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
